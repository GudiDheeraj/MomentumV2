# =============================================================================
# Momentum Tracker — the ONE config file
# =============================================================================
# Copy to `.env` and edit. Everything else (frontend/env.js, extension/
# config.js, CORS, docker port mappings, the Telegram "Open app" button) is
# derived from the values below — you should never have to edit a URL twice.
#
# After changing anything in the LINKS block, run:
#
#     python generate_frontend_env.py
#
# That rewrites frontend/env.js + extension/config.js and re-syncs the
# BACKEND_PORT / FRONTEND_PORT lines below so docker-compose publishes the
# ports your URLs actually name. (The frontend container runs it on startup,
# so with Docker a plain `docker compose up` is enough.)


# -----------------------------------------------------------------------------
# LINKS — the only two URLs you edit
# -----------------------------------------------------------------------------
# Where the backend is reachable FROM THE BROWSER. Everything that needs to
# call the API (web app, Chrome extension) derives its base URL from this.
BACKEND_URL=http://localhost:8000

# Where the frontend is served. Used for CORS (which origins may call the
# backend) and, when it's an https:// URL, for the "Open app" button on the
# Telegram card.
FRONTEND_URL=http://localhost:5173

# Derived from the two URLs above — docker-compose publishes these host ports.
# Managed by generate_frontend_env.py; no need to edit by hand.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Optional overrides. Leave blank unless you need them.
#   MOMENTUM_API_BASE — force a different API base than BACKEND_URL (e.g. a
#                       dev tunnel while the backend still binds localhost).
#   FRONTEND_ORIGINS  — comma-separated list when more than one origin must be
#                       allowed, or "*" to allow any (development only).
#   APP_PUBLIC_URL    — public https URL for the Telegram button, if the app is
#                       reachable at a different address than FRONTEND_URL.
MOMENTUM_API_BASE=
FRONTEND_ORIGINS=
APP_PUBLIC_URL=


# -----------------------------------------------------------------------------
# Core backend
# -----------------------------------------------------------------------------
# SQLite by default; swap for postgresql+psycopg://user:pass@host/db in prod.
DATABASE_URL=sqlite:///./momentum.db

# Signs login tokens. CHANGE THIS before deploying anywhere real:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MOMENTUM_SECRET_KEY=dev-only-change-me

MOMENTUM_TOKEN_TTL_MINUTES=10080
MOMENTUM_ENV=development

# Google Sign-In. Shared by frontend and backend; blank disables the button.
GOOGLE_CLIENT_ID=


# -----------------------------------------------------------------------------
# Telegram daily card  (see TELEGRAM.md)
# -----------------------------------------------------------------------------
# From @BotFather → /newbot. Blank = integration stays completely switched off.
TELEGRAM_BOT_TOKEN=

# Timezone new links start in. Each user can change theirs with /tz.
TELEGRAM_DEFAULT_TZ=Europe/London

# 0 disables delivery without removing the token. IMPORTANT: exactly one
# process may long-poll a given bot token — with multiple uvicorn workers or
# replicas, set this to 0 on all but one. A 409 in the log is this.
TELEGRAM_ENABLED=1

# Optional: skips a getMe call at startup.
TELEGRAM_BOT_USERNAME=

# How late a missed morning send may still be delivered, in minutes.
TELEGRAM_CATCHUP_MINUTES=180
TELEGRAM_POLL_TIMEOUT=25
TELEGRAM_LINK_CODE_TTL_MIN=15


# -----------------------------------------------------------------------------
# Tutorial video
# -----------------------------------------------------------------------------
# The walkthrough shown on the Home page and linked from the help panel. Paste
# any normal YouTube URL — watch?v=, youtu.be/ and /embed/ are all understood,
# and the video id is pulled out of it. Blank hides the video card entirely
# rather than leaving a dead player on the page.
TUTORIAL_VIDEO_URL=https://www.youtube.com/watch?v=D0UnqGm_miA
# Shown under the title on the card. Optional.
TUTORIAL_VIDEO_TITLE=Momentum App - Complete Walkthrough & Tutorial
TUTORIAL_VIDEO_DURATION=12:45
TUTORIAL_VIDEO_LEVEL=Beginner

# -----------------------------------------------------------------------------
# Cache (optional — the app runs fine with none of this set)
# -----------------------------------------------------------------------------
# Blank = bounded in-process cache. docker compose sets this to the bundled
# Redis automatically.
REDIS_URL=

# Seconds. PDFs and ATS scores are keyed by a hash of their input, so these
# bound memory rather than correctness. LLM output is the most expensive thing
# here, hence the longest life.
CACHE_TTL_PDF=3600
CACHE_TTL_ATS=86400
CACHE_TTL_AI=604800


# -----------------------------------------------------------------------------
# Local AI assistant (optional)
# -----------------------------------------------------------------------------
MOMENTUM_LLM_DISABLED=0
MOMENTUM_LLM_MODEL_PATH=
MOMENTUM_LLM_CONTEXT=4096
MOMENTUM_LLM_THREADS=
MOMENTUM_LLM_GPU_LAYERS=0
